# Family VPN Panel — deployment configuration.
#
# Copy to /etc/vpnpanel/panel.env on the server and edit:
#   sudo install -d -m 750 /etc/vpnpanel
#   sudo install -m 640 .env.example /etc/vpnpanel/panel.env
#
# Every value below is a documentation example (RFC 5737 / example.com).
# Never commit your real panel.env.

# --- Public VPN endpoint (what client profiles connect to) ----------------
# or a public IPv4, e.g. 203.0.113.10
VPN_PUBLIC_HOST=vpn.example.com
VPN_PUBLIC_PORT=443
# tcp or udp
VPN_PROTOCOL=tcp

# --- Tunnel addressing -----------------------------------------------------
# must be /24 or larger
VPN_IPV4_SUBNET=10.8.0.0/24
# first host of the subnet
VPN_SERVER_ADDRESS=10.8.0.1
# Unique-local IPv6 used ONLY to capture and refuse client IPv6 (leak protection).
# The installer generates a random fd00::/8 prefix if you leave the example value.
VPN_IPV6_SUBNET=fd00:8:0:1::/64
VPN_INTERFACE=tun0
# interface that reaches the internet
PUBLIC_INTERFACE=eth0

# --- Admin panel -----------------------------------------------------------
# keep on the VPN address (recommended)
ADMIN_BIND_HOST=10.8.0.1
ADMIN_PORT=8443
# resolved by AdGuard Home to VPN_SERVER_ADDRESS
ADMIN_DNS_NAME=vpn-panel.home.arpa
# local uvicorn port behind nginx (127.0.0.1 only)
APP_PORT=8090
# optional text under the logo, e.g. "Home VPN"
SERVER_LABEL=
# default display timezone (IANA name)
LOCAL_TIMEZONE=UTC

# --- Paths -----------------------------------------------------------------
OPENVPN_CONFIG_DIR=/etc/openvpn/server
EASYRSA_DIR=/etc/openvpn/easy-rsa
DATABASE_PATH=/var/lib/vpnpanel/vpnpanel.db
BACKUP_DIR=/var/backups/family-vpn-panel

# --- Filter-bypass protection ----------------------------------------------
# Extra public DNS resolver addresses (comma-separated IPv4 or networks, /16 or smaller) that
# devices with "Prevent filter bypass" may not contact directly. Built-in list covers the major
# public resolvers; leave empty unless you need more.
EXTRA_BLOCKED_RESOLVERS=

# --- AdGuard Home ----------------------------------------------------------
# local-only API
ADGUARD_URL=http://127.0.0.1:3080
# Credentials live in /etc/vpnpanel/adguard.env (created by the installer):
#   ADGUARD_USER=...
#   ADGUARD_PASSWORD=...
