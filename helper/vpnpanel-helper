#!/usr/bin/python3 -I
"""vpnpanel-helper — the only privileged component of the VPN admin panel.

Invoked by the unprivileged `vpnpanel` service through a single sudoers rule:

    vpnpanel ALL=(root) NOPASSWD: /usr/local/sbin/vpnpanel-helper

Every verb validates its arguments strictly. Output is JSON on stdout.
Private keys are never logged; the client key exists on disk only for the
few hundred milliseconds between Easy-RSA writing it and this helper shredding
it after embedding it in the returned profile.
"""
import ipaddress
import json
import os
import re
import socket
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone

# Deployment values come ONLY from this root-owned file (never from the caller's
# environment: sudo resets it and python runs isolated with -I).
ENV_FILE = "/etc/vpnpanel/panel.env"
MGMT_SOCK = "/run/openvpn-server/management.sock"
NFT_FILE = "/etc/vpnpanel/vpnpanel.nft"
NFT_DIR = "/etc/vpnpanel"


def read_env_file(path):
    values = {}
    try:
        with open(path) as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        return values
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, _, v = line.partition("=")
        v = v.strip()
        if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
            v = v[1:-1]
        values[k.strip()] = v
    return values


# Well-known public DNS resolvers that also answer DNS-over-HTTPS/TLS/QUIC on their IP address.
# These addresses are dedicated to DNS service (no shared web hosting), so blocking them for a
# device with "Prevent filter bypass" stops encrypted DNS that needs no hostname lookup, while
# plain DNS to them keeps working because port 53 is redirected to the filtering resolver.
# Extend per deployment with EXTRA_BLOCKED_RESOLVERS in panel.env.
DNS_RESOLVERS = (
    # Cloudflare
    "1.1.1.1", "1.0.0.1", "1.1.1.2", "1.0.0.2", "1.1.1.3", "1.0.0.3",
    # Google Public DNS
    "8.8.8.8", "8.8.4.4",
    # Quad9
    "9.9.9.9", "149.112.112.112", "9.9.9.10", "149.112.112.10", "9.9.9.11", "149.112.112.11",
    # Cisco OpenDNS
    "208.67.222.222", "208.67.220.220", "208.67.222.123", "208.67.220.123",
    # AdGuard DNS
    "94.140.14.14", "94.140.15.15", "94.140.14.15", "94.140.15.16", "94.140.14.140", "94.140.14.141",
    # CleanBrowsing
    "185.228.168.9", "185.228.169.9", "185.228.168.10", "185.228.169.11", "185.228.168.168", "185.228.169.168",
    # Mullvad DNS
    "194.242.2.2", "194.242.2.3", "194.242.2.4", "194.242.2.5", "194.242.2.6", "194.242.2.9",
    # DNS.SB
    "185.222.222.222", "45.11.45.11",
)
EXTRA_RESOLVERS = []


def configure(values):
    """Derive all module settings from a config mapping (also used by the unit tests)."""
    global CFG, EASYRSA_DIR, PKI, SERVER_DIR, CCD_DIR, CRL_LIVE, TLS_CRYPT
    global VPN_NET, SERVER_IP, VPN_NET6, VPN_IF, PUBLIC_IF
    CFG = {
        "VPN_PUBLIC_HOST": "vpn.example.com", "VPN_PUBLIC_PORT": "443", "VPN_PROTOCOL": "tcp",
        "VPN_IPV4_SUBNET": "10.8.0.0/24", "VPN_IPV6_SUBNET": "fd00:8:0:1::/64",
        "VPN_INTERFACE": "tun0", "PUBLIC_INTERFACE": "eth0",
        "ADMIN_PORT": "8443", "ADGUARD_URL": "http://127.0.0.1:3080",
        "OPENVPN_CONFIG_DIR": "/etc/openvpn/server", "EASYRSA_DIR": "/etc/openvpn/easy-rsa",
    }
    CFG.update(values)
    EASYRSA_DIR = CFG["EASYRSA_DIR"]
    PKI = EASYRSA_DIR + "/pki"
    SERVER_DIR = CFG["OPENVPN_CONFIG_DIR"]
    CCD_DIR = SERVER_DIR + "/ccd"
    CRL_LIVE = SERVER_DIR + "/crl.pem"
    TLS_CRYPT = SERVER_DIR + "/tls-crypt.key"
    VPN_NET = ipaddress.ip_network(CFG["VPN_IPV4_SUBNET"])
    SERVER_IP = ipaddress.ip_address(CFG.get("VPN_SERVER_ADDRESS") or str(VPN_NET.network_address + 1))
    VPN_NET6 = ipaddress.ip_network(CFG["VPN_IPV6_SUBNET"])
    for name in ("VPN_INTERFACE", "PUBLIC_INTERFACE"):
        if not re.match(r"^[A-Za-z0-9_.-]{1,15}$", CFG[name]):
            raise ValueError(f"invalid {name}")
    VPN_IF, PUBLIC_IF = CFG["VPN_INTERFACE"], CFG["PUBLIC_INTERFACE"]
    for name in ("VPN_PUBLIC_PORT", "ADMIN_PORT"):
        int(CFG[name])
    if not re.match(r"^[A-Za-z0-9.:-]{1,253}$", CFG["VPN_PUBLIC_HOST"]):
        raise ValueError("invalid VPN_PUBLIC_HOST")
    global EXTRA_RESOLVERS
    EXTRA_RESOLVERS = []
    for item in filter(None, (x.strip() for x in CFG.get("EXTRA_BLOCKED_RESOLVERS", "").split(","))):
        net = ipaddress.ip_network(item, strict=True)  # ValueError for nonsense
        if net.version != 4 or not net.is_global or net.prefixlen < 16:
            raise ValueError("EXTRA_BLOCKED_RESOLVERS: only public IPv4 addresses or networks of /16 or smaller")
        EXTRA_RESOLVERS.append(str(net))
    if len(EXTRA_RESOLVERS) > 256:
        raise ValueError("EXTRA_BLOCKED_RESOLVERS: at most 256 entries")


configure(read_env_file(ENV_FILE))

CN_RE = re.compile(r"^[a-z0-9][a-z0-9-]{1,62}$")
RESERVED_CN = {"server", "ca"}
SERVICES = ("openvpn-server@server", "adguardhome", "vpnpanel", "nginx", "ufw", "vpnpanel-nft", "ssh")

os.umask(0o077)
os.environ["PATH"] = "/usr/sbin:/usr/bin:/sbin:/bin"


class HelperError(Exception):
    pass


def out(obj):
    sys.stdout.write(json.dumps(obj))
    sys.stdout.write("\n")


def fail(msg, code=2):
    out({"ok": False, "error": msg})
    sys.exit(code)


def check_cn(cn):
    if not isinstance(cn, str) or not CN_RE.match(cn) or cn in RESERVED_CN:
        raise HelperError("invalid common name")
    return cn


def check_client_ip(ip):
    try:
        addr = ipaddress.ip_address(ip)
    except ValueError as e:
        raise HelperError("invalid ip") from e
    if addr not in VPN_NET or addr == SERVER_IP or addr in (VPN_NET.network_address, VPN_NET.broadcast_address):
        raise HelperError("ip outside client range")
    return str(addr)


SAFE_ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"}


def run(cmd, env=None, check=True, input_data=None):
    # Fixed, minimal environment: nothing from the caller reaches root subprocesses, even if the
    # sudo policy were ever changed to keep variables (OPENSSL_CONF, EASYRSA_*, LD_* ...).
    e = dict(SAFE_ENV)
    if env:
        e.update(env)
    p = subprocess.run(cmd, env=e, input=input_data, capture_output=True, text=True)
    if check and p.returncode != 0:
        # stderr from easyrsa/nft never contains key material
        raise HelperError(f"{os.path.basename(cmd[0])} failed: {p.stderr.strip()[-400:]}")
    return p


def easyrsa(args, extra_env=None):
    env = {"EASYRSA_BATCH": "1", "EASYRSA_PKI": PKI, "EASYRSA_CRL_DAYS": "3650"}
    if extra_env:
        env.update(extra_env)
    return run([EASYRSA_DIR + "/easyrsa", "--pki-dir=" + PKI] + args, env=env)


def shred(path):
    if os.path.exists(path):
        subprocess.run(["shred", "-u", "-z", path], capture_output=True)
        if os.path.exists(path):
            os.unlink(path)


def read(path):
    with open(path) as f:
        return f.read()


def pem_block(text, kind):
    m = re.search(rf"-----BEGIN {kind}-----.*?-----END {kind}-----", text, re.S)
    if not m:
        raise HelperError(f"malformed {kind}")
    return m.group(0)


def cert_meta(path):
    p = run(["openssl", "x509", "-in", path, "-noout", "-serial", "-startdate", "-enddate", "-subject"])
    meta = {}
    for line in p.stdout.splitlines():
        k, _, v = line.partition("=")
        meta[k.strip()] = v.strip()

    def iso(s):
        return datetime.strptime(s, "%b %d %H:%M:%S %Y %Z").replace(tzinfo=timezone.utc).isoformat()

    return {"serial": meta["serial"].upper(), "not_before": iso(meta["notBefore"]), "not_after": iso(meta["notAfter"])}


def install_crl():
    easyrsa(["gen-crl"])
    tmp = CRL_LIVE + ".tmp"
    with open(PKI + "/crl.pem") as src, open(tmp, "w") as dst:
        dst.write(src.read())
    os.chmod(tmp, 0o644)
    os.replace(tmp, CRL_LIVE)  # atomic: OpenVPN re-reads the CRL on each new TLS handshake


# ---------------------------------------------------------------- verbs

def v_issue(cn, days, display=""):
    """Issue a unique client certificate and return a complete .ovpn profile."""
    check_cn(cn)
    days = int(days)
    if not 1 <= days <= 3650:
        raise HelperError("days out of range")
    display = re.sub(r"[^\w .,'()-]", "", str(display))[:80]
    if os.path.exists(f"{PKI}/issued/{cn}.crt"):
        raise HelperError("certificate for this CN already exists; revoke first")
    for stale in (f"{PKI}/private/{cn}.key", f"{PKI}/reqs/{cn}.req", f"{PKI}/inline/{cn}.inline"):
        shred(stale)
    key_path = f"{PKI}/private/{cn}.key"
    try:
        easyrsa(["build-client-full", cn, "nopass"], {"EASYRSA_CERT_EXPIRE": str(days)})
        crt_path = f"{PKI}/issued/{cn}.crt"
        meta = cert_meta(crt_path)
        ca = pem_block(read(PKI + "/ca.crt"), "CERTIFICATE")
        cert = pem_block(read(crt_path), "CERTIFICATE")
        key = pem_block(read(key_path), "PRIVATE KEY")
        tlsc = read(TLS_CRYPT).strip()
        profile = "\n".join([
            f"# Family VPN profile — {display or cn}",
            f"# Device CN: {cn} · serial {meta['serial']} · valid until {meta['not_after'][:10]}",
            "# This file contains a private key. Install it on ONE device only.",
            "client",
            "dev tun",
            f"proto {'tcp-client' if CFG['VPN_PROTOCOL'] == 'tcp' else 'udp'}",
            f"remote {CFG['VPN_PUBLIC_HOST']} {int(CFG['VPN_PUBLIC_PORT'])}",
            "resolv-retry infinite",
            "nobind",
            "persist-key",
            "persist-tun",
            "remote-cert-tls server",
            "verify-x509-name server name",
            "tls-version-min 1.2",
            "data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305",
            "auth SHA256",
            "verb 3",
            "<ca>", ca, "</ca>",
            "<cert>", cert, "</cert>",
            "<key>", key, "</key>",
            "<tls-crypt>", tlsc, "</tls-crypt>",
            "",
        ])
    finally:
        # Never keep client private keys on the server.
        shred(key_path)
        shred(f"{PKI}/inline/{cn}.inline")
        shred(f"{PKI}/reqs/{cn}.req")
    return {"ok": True, "cn": cn, **meta, "profile": profile}


def v_revoke(cn, reason="cessationOfOperation"):
    check_cn(cn)
    if reason not in ("unspecified", "keyCompromise", "superseded", "cessationOfOperation", "affiliationChanged"):
        raise HelperError("bad reason")
    crt = f"{PKI}/issued/{cn}.crt"
    serial = None
    if os.path.exists(crt):
        serial = cert_meta(crt)["serial"]
        easyrsa(["revoke", cn, reason])
    install_crl()
    killed = _mgmt_kill_cn(cn)
    return {"ok": True, "cn": cn, "serial": serial, "already_revoked": serial is None, "sessions_killed": killed}


def ipv6_for(ip):
    """Readable tunnel IPv6 for a client: host offset 10 -> <prefix>::10 (digits read as hex)."""
    offset = int(ipaddress.ip_address(ip)) - int(VPN_NET.network_address)
    return str(VPN_NET6.network_address + int(str(offset), 16))


def v_ccd_write(cn, ip, enabled):
    check_cn(cn)
    ip = check_client_ip(ip)
    enabled = str(enabled) in ("1", "true", "yes")
    v6 = ipv6_for(ip)
    lines = [
        f"# managed by vpnpanel — do not edit by hand ({datetime.now(timezone.utc):%Y-%m-%d %H:%M} UTC)",
        f"ifconfig-push {ip} 255.255.255.0",
        f"ifconfig-ipv6-push {v6}/{VPN_NET6.prefixlen} {VPN_NET6.network_address + 1}",
    ]
    if not enabled:
        lines.append("disable")
    path = f"{CCD_DIR}/{cn}"
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(lines) + "\n")
    os.chmod(tmp, 0o644)  # read by OpenVPN after it drops to nobody
    os.replace(tmp, path)
    killed = 0 if enabled else _mgmt_kill_cn(cn)
    return {"ok": True, "cn": cn, "ip": ip, "enabled": enabled, "sessions_killed": killed}


def v_ccd_delete(cn):
    check_cn(cn)
    path = f"{CCD_DIR}/{cn}"
    if os.path.exists(path):
        os.unlink(path)
    return {"ok": True, "cn": cn, "sessions_killed": _mgmt_kill_cn(cn)}


def v_ccd_list():
    res = {}
    for name in sorted(os.listdir(CCD_DIR)):
        if not CN_RE.match(name):
            continue
        txt = read(f"{CCD_DIR}/{name}")
        m = re.search(r"^ifconfig-push (\S+)", txt, re.M)
        res[name] = {"ip": m.group(1) if m else None, "disabled": bool(re.search(r"^disable\s*$", txt, re.M))}
    return {"ok": True, "ccd": res}


def v_pki_list():
    """Certificate metadata from Easy-RSA's index (no key material)."""
    certs = []
    for line in read(PKI + "/index.txt").splitlines():
        parts = line.split("\t")
        if len(parts) < 6:
            continue
        status, exp, rev, serial, _, subject = parts[:6]
        m = re.search(r"/CN=([^/]+)", subject)
        cn = m.group(1) if m else subject
        certs.append({
            "cn": cn, "serial": serial.upper(),
            "status": {"V": "valid", "R": "revoked", "E": "expired"}.get(status, status),
            "not_after": _asn1_time(exp), "revoked_at": _asn1_time(rev.split(",")[0]) if rev else None,
        })
    crl = run(["openssl", "crl", "-in", CRL_LIVE, "-noout", "-nextupdate"]).stdout.strip().partition("=")[2]
    ca = cert_meta(PKI + "/ca.crt")
    return {"ok": True, "certs": certs, "crl_next_update": crl, "ca_not_after": ca["not_after"]}


def _asn1_time(s):
    s = s.strip()
    if not s:
        return None
    fmt = "%y%m%d%H%M%SZ" if len(s) == 13 else "%Y%m%d%H%M%SZ"
    return datetime.strptime(s, fmt).replace(tzinfo=timezone.utc).isoformat()


def v_crl_refresh():
    """Regenerate the CRL if it expires within 365 days (an expired CRL rejects every client)."""
    nxt = run(["openssl", "crl", "-in", CRL_LIVE, "-noout", "-nextupdate"]).stdout.strip().partition("=")[2]
    exp = datetime.strptime(nxt, "%b %d %H:%M:%S %Y %Z").replace(tzinfo=timezone.utc)
    left = (exp - datetime.now(timezone.utc)).days
    if left < 365:
        install_crl()
        return {"ok": True, "regenerated": True, "days_left_before": left}
    return {"ok": True, "regenerated": False, "days_left": left}


# ---------------------------------------------------------------- management interface

def _mgmt(cmd, timeout=5.0):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    s.connect(MGMT_SOCK)
    buf = b""
    try:
        while b"\n" not in buf:  # banner
            chunk = s.recv(4096)
            if not chunk:  # OpenVPN closed the socket (e.g. restarting): never spin as root
                raise ConnectionError("management interface closed the connection")
            buf += chunk
        s.sendall(cmd.encode() + b"\n")
        buf = b""
        deadline = time.time() + timeout
        while time.time() < deadline:
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
            text = buf.decode(errors="replace")
            if cmd.startswith("status"):
                if "\nEND\r\n" in text or text.endswith("END\r\n"):
                    break
            elif re.search(r"^(SUCCESS|ERROR):.*\r\n", text, re.M):
                break
        s.sendall(b"quit\n")
    finally:
        s.close()
    # drop asynchronous >INFO/>CLIENT notifications
    return "\n".join(ln for ln in buf.decode(errors="replace").splitlines() if not ln.startswith(">"))


def v_mgmt_status():
    text = _mgmt("status 3")
    clients = []
    for line in text.splitlines():
        f = line.split("\t")
        if f[0] == "CLIENT_LIST" and len(f) >= 12:
            clients.append({
                "cn": f[1], "real_address": f[2], "vpn_ipv4": f[3], "vpn_ipv6": f[4],
                "bytes_received": int(f[5]), "bytes_sent": int(f[6]),
                "connected_since": int(f[8]), "client_id": int(f[10]), "cipher": f[12] if len(f) > 12 else "",
            })
    return {"ok": True, "clients": clients, "ts": int(time.time())}


def _mgmt_kill_cn(cn):
    try:
        st = v_mgmt_status()
    except OSError:
        return 0
    n = 0
    for c in st["clients"]:
        if c["cn"] == cn:
            _mgmt(f"client-kill {c['client_id']} HALT")
            n += 1
    return n


def v_mgmt_kill(client_id):
    cid = int(client_id)
    if cid < 0:
        raise HelperError("bad client id")
    res = _mgmt(f"client-kill {cid} HALT")
    return {"ok": "SUCCESS" in res, "result": res.strip()[-200:]}


# ---------------------------------------------------------------- nftables

NFT_TEMPLATE = """#!/usr/sbin/nft -f
# Generated by vpnpanel-helper — do not edit by hand.
# This table only RESTRICTS VPN client traffic. UFW (iptables-nft) remains the
# authoritative firewall; nothing here can open a port UFW blocks.
table inet vpnpanel
delete table inet vpnpanel
table inet vpnpanel {{
    set no_internet {{ type ipv4_addr; {no_internet} }}
    set children {{ type ipv4_addr; {children} }}
    set panel_admins {{ type ipv4_addr; {panel_admins} }}
    set bypass_protected {{ type ipv4_addr; {bypass_protected} }}
    set tunnel_blocked {{ type ipv4_addr; {tunnel_blocked} }}
    set dns_resolvers {{ type ipv4_addr; flags interval;
        elements = {{ {dns_resolvers} }} }}
    set private4 {{ type ipv4_addr; flags interval;
        elements = {{ 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16,
                     172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/3 }} }}

    chain prerouting_nat {{
        type nat hook prerouting priority dstnat; policy accept;
        # Every VPN client must use the VPN resolver (prevents DNS leaks / bypass).
        iifname "{vpn_if}" ip daddr != {server_ip} udp dport 53 counter dnat ip to {server_ip}
        iifname "{vpn_if}" ip daddr != {server_ip} tcp dport 53 counter dnat ip to {server_ip}
    }}

    chain input {{
        type filter hook input priority filter - 10; policy accept;
        iifname "{vpn_if}" ip saddr != {vpn_net} counter drop
        iifname "{vpn_if}" tcp dport {admin_port} ip saddr != @panel_admins counter reject with tcp reset
        iifname "{vpn_if}" tcp dport {adguard_port} counter drop
    }}

    chain forward {{
        type filter hook forward priority filter - 10; policy accept;
        iifname "{vpn_if}" ip saddr != {vpn_net} counter drop
        iifname "{vpn_if}" meta nfproto ipv6 counter reject with icmpx admin-prohibited
        # Internet disabled / outside schedule / expired: VPN + DNS still work, no egress.
        iifname "{vpn_if}" ip saddr @no_internet counter reject with icmpx admin-prohibited
        # No VPN client may reach private ranges, other clients, or cloud metadata.
        iifname "{vpn_if}" ip daddr @private4 counter reject with icmpx admin-prohibited
        # Children: no DNS-over-TLS / DNS-over-QUIC bypass.
        iifname "{vpn_if}" ip saddr @children tcp dport 853 counter reject with tcp reset
        iifname "{vpn_if}" ip saddr @children udp dport 853 counter reject with icmpx admin-prohibited
        # "Prevent filter bypass": encrypted DNS straight to well-known public resolvers (by IP) and
        # DoT/DoQ anywhere. Plain DNS to these resolvers was already redirected to ours above.
        iifname "{vpn_if}" ip saddr @bypass_protected ip daddr @dns_resolvers meta l4proto tcp counter reject with tcp reset
        iifname "{vpn_if}" ip saddr @bypass_protected ip daddr @dns_resolvers counter reject with icmpx admin-prohibited
        iifname "{vpn_if}" ip saddr @bypass_protected tcp dport 853 counter reject with tcp reset
        iifname "{vpn_if}" ip saddr @bypass_protected udp dport 853 counter reject with icmpx admin-prohibited
        # "Block VPN and proxy protocols" (opt-in policy flag): standard ports of common VPN/proxy
        # protocols only. Tunnels over ordinary HTTPS (443) are deliberately NOT blocked.
        iifname "{vpn_if}" ip saddr @tunnel_blocked meta l4proto {{ esp, ah, gre }} counter reject with icmpx admin-prohibited
        iifname "{vpn_if}" ip saddr @tunnel_blocked udp dport {{ 500, 1194, 1701, 4500, 51820 }} counter reject with icmpx admin-prohibited
        iifname "{vpn_if}" ip saddr @tunnel_blocked tcp dport {{ 1080, 1194, 1723 }} counter reject with tcp reset
    }}
}}
"""


NFT_SETS = ("no_internet", "children", "panel_admins", "bypass_protected", "tunnel_blocked")


def _elements(ips):
    if not isinstance(ips, list) or not all(isinstance(i, str) for i in ips):
        raise HelperError("set members must be a list of address strings")
    ips = sorted({check_client_ip(i) for i in ips}, key=lambda s: ipaddress.ip_address(s))
    return f"elements = {{ {', '.join(ips)} }}" if ips else ""


def render_nft(data):
    """Full `inet vpnpanel` table for the given state. Sets missing from the state (older panel
    versions) render empty, so the previous rules stay exactly as they were."""
    if not isinstance(data, dict):
        raise HelperError("nft state must be a JSON object")
    sets = {name: _elements(data.get(name, [])) for name in NFT_SETS}
    resolvers = sorted({*DNS_RESOLVERS, *EXTRA_RESOLVERS}, key=lambda n: ipaddress.ip_network(n))
    return NFT_TEMPLATE.format(
        **sets, dns_resolvers=", ".join(resolvers),
        vpn_if=VPN_IF, server_ip=SERVER_IP, vpn_net=VPN_NET, admin_port=int(CFG["ADMIN_PORT"]),
        adguard_port=int(CFG["ADGUARD_URL"].rsplit(":", 1)[-1].split("/")[0] or 3080),
    )


def v_nft_apply():
    rendered = render_nft(json.load(sys.stdin))
    fd, tmp = tempfile.mkstemp(dir=NFT_DIR, prefix=".nft-")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(rendered)
        run(["nft", "-c", "-f", tmp])  # syntax check first
        run(["nft", "-f", tmp])        # atomic replace of our own table only
        os.chmod(tmp, 0o600)
        os.replace(tmp, NFT_FILE)
    finally:
        if os.path.exists(tmp):  # never leave rendered rulesets behind after a failure
            os.unlink(tmp)
    return {"ok": True}


def v_nft_counters():
    p = run(["nft", "-j", "list", "table", "inet", "vpnpanel"], check=False)
    return {"ok": p.returncode == 0, "json": json.loads(p.stdout) if p.returncode == 0 else None}


# ---------------------------------------------------------------- health

def v_health():
    svc = {}
    for s in SERVICES:
        svc[s] = run(["systemctl", "is-active", s], check=False).stdout.strip()
    ufw = run(["ufw", "status"], check=False).stdout
    nat = run(["iptables", "-t", "nat", "-S", "POSTROUTING"], check=False).stdout
    listen = run(["ss", "-Htln"], check=False).stdout
    return {
        "ok": True,
        "services": svc,
        "ufw_active": "Status: active" in ufw,
        "nat_ok": f"-s {VPN_NET} -o {PUBLIC_IF} -j MASQUERADE" in nat,
        "nat_rules": nat.count(f"-s {VPN_NET} -o {PUBLIC_IF} -j MASQUERADE"),
        "listening_vpn": bool(re.search(rf":{int(CFG['VPN_PUBLIC_PORT'])}\s", listen)),
        "ip_forward": read("/proc/sys/net/ipv4/ip_forward").strip() == "1",
        "nft_table": run(["nft", "list", "table", "inet", "vpnpanel"], check=False).returncode == 0,
    }


VERBS = {
    "issue": v_issue, "revoke": v_revoke,
    "ccd-write": v_ccd_write, "ccd-delete": v_ccd_delete, "ccd-list": v_ccd_list,
    "pki-list": v_pki_list, "crl-refresh": v_crl_refresh,
    "mgmt-status": v_mgmt_status, "mgmt-kill": v_mgmt_kill,
    "nft-apply": v_nft_apply, "nft-counters": v_nft_counters,
    "health": v_health,
}


def main():
    if os.geteuid() != 0:
        fail("must run as root via sudo")
    if len(sys.argv) < 2 or sys.argv[1] not in VERBS:
        fail(f"usage: vpnpanel-helper {{{'|'.join(VERBS)}}} ...")
    verb, args = sys.argv[1], sys.argv[2:]
    if len(args) > 4 or any(len(a) > 200 for a in args):
        fail("bad arguments")
    try:
        out(VERBS[verb](*args))
    except HelperError as e:
        fail(str(e))
    except TypeError:
        fail("wrong number of arguments")
    except (OSError, ValueError, KeyError) as e:
        fail(f"{type(e).__name__}: {e}"[:300], 3)


if __name__ == "__main__":
    main()
