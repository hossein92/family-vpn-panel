# OpenVPN server — generated by Family VPN Panel's installer for a NEW server.
# Every device has its own certificate; there is deliberately no duplicate-cn.
port @VPN_PUBLIC_PORT@
proto @OVPN_PROTO@
dev @VPN_INTERFACE@

topology subnet
# Every device gets a static address from ccd/ (ccd-exclusive): the pool is never used.
server @VPN_NETWORK@ @VPN_NETMASK@
# Unique-local IPv6 inside the tunnel only captures client IPv6 so it can be refused
# (block-ipv6) instead of leaking around an IPv4-only VPN.
server-ipv6 @VPN_IPV6_SUBNET@

ca @OPENVPN_CONFIG_DIR@/ca.crt
cert @OPENVPN_CONFIG_DIR@/server.crt
key @OPENVPN_CONFIG_DIR@/server.key
crl-verify @OPENVPN_CONFIG_DIR@/crl.pem
tls-crypt @OPENVPN_CONFIG_DIR@/tls-crypt.key
tls-version-min 1.2
dh none

data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
data-ciphers-fallback AES-256-GCM
auth SHA256

client-config-dir @OPENVPN_CONFIG_DIR@/ccd
ccd-exclusive

keepalive 10 120
persist-key
persist-tun
user nobody
group nogroup

# Local-only management interface (Unix socket, root-only directory).
management /run/openvpn-server/management.sock unix

block-ipv6
push "redirect-gateway def1 ipv6 bypass-dhcp"
push "block-ipv6"
push "dhcp-option DNS @VPN_SERVER_ADDRESS@"
push "block-outside-dns"

verb 3
